# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/baymax

# Long random string used to sign access tokens: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGIN=*

# Public URL of the web app, used in password reset links
APP_URL=http://localhost:8081

# Optional — enables real card payments through Stripe PaymentIntents
STRIPE_SECRET_KEY=

# Optional — adds an AI-written summary to symptom checker results
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
