# Base URL of the Baymax API, e.g. http://192.168.1.20:4000/api/v1
# Leave empty to run the app in self-contained demo mode (data is stored on the device).
EXPO_PUBLIC_API_URL=

# Optional — Stripe publishable key for native card payments (pk_test_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — sub-path when hosting the web build (GitHub Pages uses /Baymax)
EXPO_PUBLIC_BASE_URL=
