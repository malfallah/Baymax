{
  "name": "baymax",
  "version": "2.0.0",
  "private": true,
  "description": "Baymax — your personal healthcare companion. Book doctors, check symptoms, order medicine and learn from a health community on iOS, Android and the web.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @baymax/api & npm run start --workspace @baymax/mobile",
    "dev:api": "npm run dev --workspace @baymax/api",
    "dev:app": "npm run start --workspace @baymax/mobile",
    "web": "npm run web --workspace @baymax/mobile",
    "build:web": "npm run build:web --workspace @baymax/mobile",
    "seed": "npm run seed --workspace @baymax/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
